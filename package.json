{
  "name": "canvasmagicks",
  "version": "0.1.0",
  "description": "Command line interface for Canvas LMS, built with OpenTUI.",
  "type": "module",
  "private": true,
  "bin": {
    "canvasmagicks": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "auth": "bun run src/index.ts auth",
    "whoami": "bun run src/index.ts whoami",
    "courses": "bun run src/index.ts courses",
    "link": "bun link",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "8.6.0",
    "cmd-ts": "0.15.0",
    "marked": "18.0.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "7.0.2"
  }
}